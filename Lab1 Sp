      },
      "source": [
        "# Splitting dataset into training and testing\n",
        "train, test = train_test_split(new_dataset, test_size=0.2)\n",
        "\n",
        "# Sepparating both sets into dependent and independent variables\n",
        "\n",
        "# /* REPLACE 'None' WITH CODE YOUR CODE */\n",
        "# Hint: Make sure you select only numerical variables.\n",
        "# Feel free to choose the number of independent variables\n",
        "# you want and the dependent variable is MPG\n",
        "# Las variables independientes son tus entradas (X). Elegimos las propiedades físicas del carro.\n",
        "independent_variables = ['Cylinders', 'Displacement', 'Horsepower', 'Weight', 'Acceleration']\n",
        "\n",
        "# La variable dependiente es tu salida o etiqueta (Y), lo que querés predecir.\n",
        "dependent_variables = ['MPG']\n",
        "\n",
        "train_set = train[independent_variables]\n",
        "train_target = train[dependent_variables]\n",
        "\n",
        "test_set = test[independent_variables]\n",
        "test_target = test[dependent_variables]"
      ],
      "execution_count": 9,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "efOETJ7cPkMO",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 280
        },
        "outputId": "0467f1d7-8d90-4366-96f3-71578a7b6490"
      },
      "source": [
        "# Build your model!\n",
        "# Usamos Sequential para apilar las capas una tras otra (el pipeline del Forward-Propagation)\n",
        "modelo = tf.keras.Sequential([\n",
        "    # Capa oculta 1: 64 neuronas usando la función ReLU que vimos en clase\n",
        "    tf.keras.layers.Dense(64, activation='relu', input_shape=[len(independent_variables)]),\n",
        "\n",
        "    # Capa oculta 2: Otras 64 neuronas con ReLU para poder captar patrones más complejos\n",
        "    tf.keras.layers.Dense(64, activation='relu'),\n",
        "\n",
        "    # Capa de salida: 1 sola neurona SIN función de activación.\n",
        "    # ¿Por qué? Porque queremos predecir un número continuo (el MPG exacto), no clasificar entre 0 y 1.\n",
        "    tf.keras.layers.Dense(1)\n",
        "])\n",
        "\n",
        "# Now compile the model!\n",
        "# Aquí definimos al \"juez\" (Loss Function) y al que ajusta los pesos (Optimizer)\n",
        "modelo.compile(\n",
        "    # Adam es una versión moderna y muy eficiente del algoritmo de Descenso del Gradiente\n",
        "    optimizer=tf.keras.optimizers.Adam(learning_rate=0.001),\n",
        "\n",
        "    # Usamos MSE (Mean Squared Error) porque queremos castigar fuerte los errores grandes al predecir\n",
        "    loss='mse',\n",
        "\n",
        "    # Le pedimos que también nos calcule el MAE (Mean Absolute Error) para que lo leamos nosotros más fácil\n",
        "    metrics=['mae', 'mse']\n",
        ")\n",
        "\n",
        "# Un pequeño extra para ver cuántos \"pesos\" (W) y sesgos (b) va a entrenar la red\n",
        "modelo.summary()"
      ],
